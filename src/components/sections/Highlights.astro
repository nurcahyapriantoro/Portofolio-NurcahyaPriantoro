---
interface Highlight {
  value: string;
  label: string;
  detail: string;
}

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;
---

<section aria-label="Key Impact Metrics" class="py-10 md:py-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {highlights.map((item) => (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition hover:border-blue-200 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-blue-800/70">
          <p class="text-3xl font-extrabold tracking-tight text-blue-600 dark:text-blue-400">
            {item.value}
          </p>
          <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{item.label}</p>
          <p class="mt-1.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {item.detail}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
