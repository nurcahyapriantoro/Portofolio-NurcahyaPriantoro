---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';
import LogoMark from '@/components/ui/LogoMark.astro';
import Carousel from '@/components/ui/Carousel.astro';

interface Props {
  items: CollectionEntry<'projects'>[];
}

const { items } = Astro.props;
const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter((p) => p.data.tier === 'featured');
const other = sorted.filter((p) => p.data.tier === 'other');

const linkIcons: Record<string, string> = {
  github: 'simple-icons:github',
  demo: 'lucide:play-circle',
  live: 'lucide:external-link',
  private: 'lucide:lock',
};
---

<Section
  id="projects"
  eyebrow="Selected Work"
  title="Projects"
  subtitle="Production web platforms, internal audit tools, and permissioned blockchain governance systems."
  altBg
>
  <div class="grid gap-6 md:grid-cols-2">
    {featured.map((entry) => {
      const p = entry.data;
      return (
        <article class="flex flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700">
          {p.images.length > 0 ? (
            <Carousel id={`proj-${entry.id}`} label={p.title} slides={p.images} />
          ) : (
            <div class="flex aspect-16/9 w-full flex-col items-center justify-center rounded-xl bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 p-6 text-center text-white ring-1 ring-slate-200/80 dark:ring-slate-800">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/20">
                <Icon name="lucide:building-2" class="h-6 w-6 text-blue-300" aria-hidden="true" />
              </div>
              <p class="mt-3 text-base font-bold tracking-tight">{p.title}</p>
              <p class="mt-1 text-xs text-blue-200/80">
                {p.client} · {p.period}
              </p>
            </div>
          )}

          <div class="mt-5 flex flex-1 flex-col">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3">
                {p.logo && <LogoMark src={p.logo} alt={`${p.client} logo`} size="sm" />}
                <div>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white">{p.title}</h3>
                  <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                    {p.client} · {p.period}
                  </p>
                </div>
              </div>
              {p.status && (
                <Badge
                  variant={p.status === 'Live' || p.status === 'Production' ? 'success' : 'neutral'}
                >
                  {p.status}
                </Badge>
              )}
            </div>

            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              {p.summary}
            </p>

            {p.bullets.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                {p.bullets.map((b) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-600 dark:bg-blue-400" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
              <div class="flex flex-wrap gap-1.5">
                {p.tech.map((t) => (
                  <Badge variant="default">{t}</Badge>
                ))}
              </div>

              {p.links.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {p.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400"
                    >
                      <Icon
                        name={linkIcons[l.kind] ?? 'lucide:external-link'}
                        class="h-3.5 w-3.5"
                        aria-hidden="true"
                      />
                      <span>{l.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  {other.length > 0 && (
    <div class="mt-14">
      <h3 class="mb-5 text-base font-bold text-slate-900 dark:text-white">
        Additional &amp; Academic Projects
      </h3>
      <div class="grid gap-5 md:grid-cols-3">
        {other.map((entry) => {
          const p = entry.data;
          return (
            <article class="flex flex-col rounded-2xl border border-slate-200/90 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
              {p.images.length > 0 && (
                <Carousel id={`proj-${entry.id}`} label={p.title} slides={p.images} />
              )}
              <div class="mt-4 flex flex-1 flex-col">
                <h4 class="text-base font-bold text-slate-900 dark:text-white">{p.title}</h4>
                <p class="text-xs text-slate-500 dark:text-slate-400">{p.subtitle}</p>
                <p class="mt-2 flex-1 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                  {p.summary}
                </p>
                <div class="mt-3 flex flex-wrap gap-1">
                  {p.tech.map((t) => (
                    <Badge variant="default">{t}</Badge>
                  ))}
                </div>
                {p.links.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2 border-t border-slate-100 pt-3 dark:border-slate-800">
                    {p.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
                      >
                        <span>{l.label}</span>
                        <Icon name="lucide:external-link" class="h-3 w-3" aria-hidden="true" />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}
</Section>
