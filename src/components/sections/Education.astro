---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';
import LogoMark from '@/components/ui/LogoMark.astro';
import { formatDateRange } from '@/lib/format-date';

interface Props {
  education: CollectionEntry<'education'>['data'];
}

const { education } = Astro.props;
---

<Section id="education" eyebrow="Academic Background" title="Education" altBg>
  <div class="overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-2xs dark:border-slate-800 dark:bg-slate-900">
    <div class="grid items-stretch lg:grid-cols-12">
      <div class="relative min-h-64 bg-slate-900 lg:col-span-5">
        <Image
          src={education.photo}
          alt="Nurcahya Priantoro graduation ceremony at IPB University"
          widths={[480, 900]}
          sizes="(max-width: 1024px) 100vw, 480px"
          class="h-full w-full object-cover object-center"
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent p-5 text-white">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/90 px-2.5 py-0.5 text-xs font-semibold text-white">
            <Icon name="lucide:award" class="h-3.5 w-3.5" aria-hidden="true" />
            <span>{education.status}</span>
          </span>
          <p class="mt-2 text-xs text-slate-200">IPB University Convocation · Bogor, Indonesia</p>
        </div>
      </div>

      <div class="flex flex-col justify-between p-6 sm:p-8 lg:col-span-7">
        <div>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-start gap-4">
              <LogoMark src={education.logo} alt={`${education.institution} logo`} size="lg" />
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  {education.institution}
                </h3>
                <p class="mt-0.5 text-base font-semibold text-blue-600 dark:text-blue-400">
                  {education.degree}
                </p>
                <p class="text-xs text-slate-500 dark:text-slate-400">{education.faculty}</p>
              </div>
            </div>

            <div class="text-xs text-slate-500 sm:text-right dark:text-slate-400">
              <p class="font-semibold text-slate-800 dark:text-slate-200">
                {formatDateRange(education.start, education.end)}
              </p>
              <p class="mt-1 inline-flex items-center gap-1 rounded-md bg-blue-50 px-2 py-0.5 font-semibold text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
                GPA: {education.gpa}
              </p>
            </div>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-5 dark:border-slate-800">
            <h4 class="mb-3 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">
              Relevant Coursework
            </h4>
            <div class="flex flex-wrap gap-2">
              {education.coursework.map((course) => (
                <Badge variant="default">{course}</Badge>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 pt-5 dark:border-slate-800">
          <span class="inline-flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
            <Icon name="lucide:map-pin" class="h-3.5 w-3.5" aria-hidden="true" />
            <span>{education.location}</span>
          </span>
          <a
            href={education.website}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
          >
            <span>Visit IPB University</span>
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>
