---
import { Icon } from 'astro-icon/components';
import { withBase } from '@/lib/site';

interface Props {
  email: string;
  cvPath: string;
  linkedinUrl: string;
  studio?:
    | {
        name: string;
        url: string;
        role: string;
        summary: string;
      }
    | undefined;
}

const { email, cvPath, linkedinUrl, studio } = Astro.props;
---

<section aria-label="Contact & Services Call to Action" class="py-16">
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <div class="grid gap-6 overflow-hidden rounded-2xl border border-blue-200/80 bg-gradient-to-br from-blue-600 via-blue-700 to-slate-900 p-7 text-white shadow-lg sm:p-10 lg:grid-cols-12 lg:items-center dark:border-blue-900/60">
      <div class:list={['space-y-5', studio ? 'lg:col-span-7' : 'lg:col-span-12']}>
        <div class="space-y-2">
          <p class="text-xs font-semibold tracking-widest text-blue-200 uppercase">
            Open to Opportunities
          </p>
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
            Looking for a Data Engineer, Fullstack, or Blockchain Engineer?
          </h2>
          <p class="max-w-xl text-sm leading-relaxed text-blue-100">
            Let&apos;s discuss how I can contribute to your data platform, risk surveillance, or
            software engineering team.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${email}?subject=${encodeURIComponent('Opportunity — Nurcahya Priantoro')}`}
            class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-slate-900 shadow-xs transition duration-200 hover:-translate-y-0.5 hover:bg-blue-50"
          >
            <Icon name="lucide:mail" class="h-4 w-4 text-blue-600" aria-hidden="true" />
            <span>Email Me</span>
          </a>
          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/30 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white backdrop-blur-xs transition hover:bg-white/20"
          >
            <Icon name="simple-icons:linkedin" class="h-4 w-4" aria-hidden="true" />
            <span>LinkedIn</span>
          </a>
          <a
            href={withBase(cvPath)}
            download="Nurcahya_Priantoro_CV.pdf"
            class="inline-flex items-center gap-2 rounded-lg border border-white/30 bg-white/10 px-4 py-2.5 text-sm font-semibold text-white backdrop-blur-xs transition hover:bg-white/20"
          >
            <Icon name="lucide:file-down" class="h-4 w-4" aria-hidden="true" />
            <span>CV</span>
          </a>
        </div>
      </div>

      {studio && (
        <div class="rounded-xl border border-white/20 bg-slate-950/35 p-5 backdrop-blur-md sm:p-6 lg:col-span-5">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-400/15 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300 ring-1 ring-emerald-400/30">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span>Client &amp; Business Services</span>
          </div>
          <h3 class="mt-3 text-lg font-bold text-white">{studio.name}</h3>
          <p class="mt-0.5 text-xs font-medium text-blue-200">{studio.role}</p>
          <p class="mt-2.5 text-xs leading-relaxed text-slate-200">{studio.summary}</p>
          <a
            href={studio.url}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-white/95 px-4 py-2.5 text-xs font-bold text-slate-900 shadow-xs transition duration-200 hover:-translate-y-0.5 hover:bg-white sm:text-sm"
          >
            <span>Hire via cocotech.studio</span>
            <Icon name="lucide:arrow-up-right" class="h-4 w-4 text-blue-600" aria-hidden="true" />
          </a>
        </div>
      )}
    </div>
  </div>
</section>
