---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import { withBase } from '@/lib/site';

interface Props {
  pdfPath: string;
  sizeLabel: string;
}

const { pdfPath, sizeLabel } = Astro.props;
const pdfUrl = withBase(pdfPath);

const pageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio-pages/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const pages = Object.entries(pageModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<Section
  id="portfolio"
  eyebrow="Document Preview"
  title="Portfolio Deck (PDF)"
  subtitle="Interactive presentation deck summarizing my work at PT Pertamina (Persero), Bank Indonesia, RTRWHUB, and BRAIN IPB University."
  altBg
>
  <div class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-6 dark:border-slate-800 dark:bg-slate-900">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
          <Icon name="lucide:file-text" class="h-5 w-5" aria-hidden="true" />
        </div>
        <div>
          <p class="text-sm font-bold text-slate-900 dark:text-white">
            Portfolio-Nurcahya-Priantoro.pdf
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {sizeLabel} · Printable &amp; Offline Ready
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={pdfUrl}
          download="Portfolio-Nurcahya-Priantoro.pdf"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition hover:bg-blue-700 sm:text-sm"
        >
          <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
          <span>Download Portfolio PDF</span>
        </a>
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          <span>Open in New Tab</span>
          <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Desktop: lazy-loaded native PDF viewer -->
    <div class="hidden overflow-hidden rounded-xl border border-slate-200 bg-slate-100 md:block dark:border-slate-800 dark:bg-slate-950">
      <iframe
        src={`${pdfUrl}#view=FitH`}
        title="Portfolio Nurcahya Priantoro (PDF)"
        loading="lazy"
        class="aspect-16/9 w-full border-0"
      ></iframe>
    </div>

    <!-- Mobile: high-res rendered slide previews (mobile browsers typically cannot render PDFs inline in iframes) -->
    <div class="space-y-4 md:hidden">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Slide preview (tap <strong>Download Portfolio PDF</strong> above for the full PDF file):
      </p>
      <div class="grid gap-3">
        {pages.map((pageImg, idx) => (
          <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
            <Image
              src={pageImg}
              alt={`Portfolio slide ${idx + 1} of ${pages.length}`}
              widths={[480, 960]}
              sizes="100vw"
              class="w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>
