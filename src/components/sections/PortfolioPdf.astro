---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import { withBase } from '@/lib/site';

interface Props {
  pdfPath: string;
  sizeLabel: string;
  cvPath: string;
  cvLabel?: string | undefined;
}

const { pdfPath, sizeLabel, cvPath, cvLabel = '3 Pages · Curriculum Vitae PDF' } = Astro.props;
const pdfUrl = withBase(pdfPath);
const cvUrl = withBase(cvPath);

const deckModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio-pages/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const deckPages = Object.entries(deckModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);

const cvModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/cv-pages/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const cvPages = Object.entries(cvModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
---

<Section
  id="portfolio"
  eyebrow="Documents & Resume"
  title="Portfolio Deck & CV (PDF)"
  subtitle="Preview and download my interactive presentation portfolio or full ATS-ready Curriculum Vitae directly below."
  altBg
>
  <div
    data-doc-tabs
    class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-6 dark:border-slate-800 dark:bg-slate-900"
  >
    <div class="mb-5 flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 pb-4 dark:border-slate-800">
      <div
        role="tablist"
        aria-label="Document Preview Tabs"
        class="inline-flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800/80"
      >
        <button
          id="tab-portfolio-deck"
          type="button"
          role="tab"
          data-doc-tab="portfolio"
          aria-selected="true"
          aria-controls="panel-portfolio-deck"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-3.5 py-2 text-xs font-semibold text-slate-900 shadow-xs transition sm:text-sm dark:bg-slate-900 dark:text-white"
        >
          <Icon
            name="lucide:presentation"
            class="h-4 w-4 text-blue-600 dark:text-blue-400"
            aria-hidden="true"
          />
          <span>Portfolio Deck</span>
        </button>

        <button
          id="tab-cv-pdf"
          type="button"
          role="tab"
          data-doc-tab="cv"
          aria-selected="false"
          aria-controls="panel-cv-pdf"
          tabindex="-1"
          class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2 text-xs font-semibold text-slate-600 transition hover:text-slate-900 sm:text-sm dark:text-slate-400 dark:hover:text-white"
        >
          <Icon
            name="lucide:file-user"
            class="h-4 w-4 text-blue-600 dark:text-blue-400"
            aria-hidden="true"
          />
          <span>Curriculum Vitae (CV)</span>
        </button>
      </div>

      <p class="text-xs text-slate-500 dark:text-slate-400">
        Native PDF viewer on desktop · Optimized crisp page previews on mobile
      </p>
    </div>

    <!-- Panel 1: Portfolio Deck -->
    <div
      id="panel-portfolio-deck"
      role="tabpanel"
      aria-labelledby="tab-portfolio-deck"
      data-doc-panel="portfolio"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
            <Icon name="lucide:file-text" class="h-5 w-5" aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">
              Portfolio-Nurcahya-Priantoro.pdf
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              {sizeLabel} · Printable &amp; Offline Ready
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href={pdfUrl}
            download="Portfolio-Nurcahya-Priantoro.pdf"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition hover:bg-blue-700 sm:text-sm"
          >
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
            <span>Download Portfolio PDF</span>
          </a>
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
          >
            <span>Open in New Tab</span>
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="hidden overflow-hidden rounded-xl border border-slate-200 bg-slate-100 md:block dark:border-slate-800 dark:bg-slate-950">
        <iframe
          src={`${pdfUrl}#view=FitH`}
          title="Portfolio Nurcahya Priantoro (PDF)"
          loading="lazy"
          class="aspect-16/9 w-full border-0"
        ></iframe>
      </div>

      <div class="space-y-4 md:hidden">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Slide preview (tap <strong>Download Portfolio PDF</strong> above for the full PDF file):
        </p>
        <div class="grid gap-3">
          {deckPages.map((pageImg, idx) => (
            <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
              <Image
                src={pageImg}
                alt={`Portfolio slide ${idx + 1} of ${deckPages.length}`}
                widths={[480, 960]}
                sizes="100vw"
                class="w-full object-cover"
              />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Panel 2: Curriculum Vitae (CV) -->
    <div
      id="panel-cv-pdf"
      role="tabpanel"
      aria-labelledby="tab-cv-pdf"
      data-doc-panel="cv"
      class="hidden"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
            <Icon name="lucide:file-user" class="h-5 w-5" aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900 dark:text-white">
              Nurcahya_Priantoro_CV.pdf
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
              {cvLabel} · ATS &amp; Recruiter Ready
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href={cvUrl}
            download="Nurcahya_Priantoro_CV.pdf"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-xs font-semibold text-white shadow-xs transition hover:bg-blue-700 sm:text-sm"
          >
            <Icon name="lucide:download" class="h-4 w-4" aria-hidden="true" />
            <span>Download CV PDF</span>
          </a>
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50 sm:text-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
          >
            <span>Open in New Tab</span>
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="hidden overflow-hidden rounded-xl border border-slate-200 bg-slate-100 md:block dark:border-slate-800 dark:bg-slate-950">
        <iframe
          src={`${cvUrl}#view=FitH`}
          title="Curriculum Vitae Nurcahya Priantoro (PDF)"
          loading="lazy"
          class="h-[78vh] min-h-[600px] w-full border-0"
        ></iframe>
      </div>

      <div class="space-y-4 md:hidden">
        <p class="text-xs text-slate-500 dark:text-slate-400">
          CV page preview (tap <strong>Download CV PDF</strong> above for the selectable PDF):
        </p>
        <div class="grid gap-3">
          {cvPages.map((pageImg, idx) => (
            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xs dark:border-slate-800">
              <Image
                src={pageImg}
                alt={`Curriculum Vitae page ${idx + 1} of ${cvPages.length}`}
                widths={[480, 960]}
                sizes="100vw"
                class="w-full object-contain"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>
