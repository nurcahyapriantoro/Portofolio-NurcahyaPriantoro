---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import LogoMark from '@/components/ui/LogoMark.astro';

interface Props {
  items: CollectionEntry<'organizations'>[];
}

const { items } = Astro.props;
const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
---

<Section
  id="organizations"
  eyebrow="Leadership & Campus"
  title="Organizational Experience"
  subtitle="Research teams, IEEE Student Branch leadership, and campus multimedia initiatives."
>
  <div class="grid gap-4 md:grid-cols-2">
    {sorted.map((entry) => {
      const o = entry.data;
      return (
        <article class="flex items-start gap-4 rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
          <LogoMark src={o.logo} alt={`${o.organization} logo`} size="md" />
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">{o.role}</h3>
              <span class="text-xs font-medium text-blue-600 dark:text-blue-400">{o.period}</span>
            </div>
            <p class="text-xs font-semibold text-slate-600 dark:text-slate-300">{o.organization}</p>
            {o.topic && (
              <p class="mt-1 text-xs italic text-slate-500 dark:text-slate-400">Topic: {o.topic}</p>
            )}
            <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-300">
              {o.summary}
            </p>
            {o.certificateUrl && (
              <a
                href={o.certificateUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2.5 inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
              >
                <span>Certificate</span>
                <Icon name="lucide:external-link" class="h-3 w-3" aria-hidden="true" />
              </a>
            )}
          </div>
        </article>
      );
    })}
  </div>
</Section>
