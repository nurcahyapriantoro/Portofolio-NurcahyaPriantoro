---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  items: CollectionEntry<'certifications'>[];
}

const { items } = Astro.props;
const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
const featured = sorted.filter((c) => c.data.featured);
const rest = sorted.filter((c) => !c.data.featured);
const filterGroups = ['All', 'Dicoding', 'IDCamp', 'LinkedIn'];
---

<Section
  id="certifications"
  eyebrow="Credentials"
  title="Certifications & Training"
  subtitle="Industry-recognized certifications in AI, Cloud Engineering, Blockchain, and Data Science."
>
  <div class="grid gap-5 md:grid-cols-3">
    {featured.map((entry) => {
      const c = entry.data;
      return (
        <article class="flex flex-col rounded-2xl border border-blue-200/80 bg-white p-5 shadow-2xs dark:border-blue-900/60 dark:bg-slate-900">
          <div class="flex items-start justify-between gap-3">
            {c.badgeImage && (
              <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white p-1.5 ring-1 ring-slate-200">
                <Image
                  src={c.badgeImage}
                  alt={c.title}
                  widths={[80, 160]}
                  sizes="56px"
                  class="h-full w-full object-contain"
                />
              </div>
            )}
            <Badge variant="brand">{c.issuerGroup}</Badge>
          </div>

          <h3 class="mt-4 text-base font-bold text-slate-900 dark:text-white">{c.title}</h3>
          <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">
            {c.issuer} · {c.issued}
          </p>

          {c.highlights.length > 0 && (
            <ul class="mt-3 flex-1 space-y-1 text-xs text-slate-600 dark:text-slate-300">
              {c.highlights.map((h) => (
                <li class="flex items-start gap-1.5">
                  <Icon
                    name="lucide:check"
                    class="mt-0.5 h-3.5 w-3.5 shrink-0 text-blue-600 dark:text-blue-400"
                    aria-hidden="true"
                  />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}

          {c.credentialUrl && (
            <div class="mt-4 border-t border-slate-100 pt-3 dark:border-slate-800">
              <a
                href={c.credentialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
              >
                <span>Verify Credential</span>
                <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
              </a>
            </div>
          )}
        </article>
      );
    })}
  </div>

  <div class="mt-10">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white">
        Specialized Coursework &amp; Certificates ({rest.length})
      </h3>
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter certifications">
        {filterGroups.map((group, idx) => {
          const value = group.toLowerCase();
          const active = idx === 0;
          return (
            <button
              type="button"
              data-cert-filter={value}
              aria-pressed={active ? 'true' : 'false'}
              class:list={[
                'rounded-lg border px-3 py-1.5 text-xs font-semibold transition',
                active
                  ? 'border-blue-600 bg-blue-600 text-white'
                  : 'border-slate-200 bg-white text-slate-700 hover:border-blue-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300',
              ]}
            >
              {group}
            </button>
          );
        })}
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((entry) => {
        const c = entry.data;
        return (
          <article
            data-cert-group={c.issuerGroup.toLowerCase()}
            class="flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-4 shadow-2xs dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="flex items-start gap-3">
              {c.badgeImage ? (
                <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-white p-1 ring-1 ring-slate-200">
                  <Image
                    src={c.badgeImage}
                    alt={c.issuer}
                    widths={[64, 128]}
                    sizes="40px"
                    class="h-full w-full object-contain"
                  />
                </div>
              ) : (
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
                  <Icon name={c.icon ?? 'lucide:award'} class="h-4.5 w-4.5" aria-hidden="true" />
                </div>
              )}

              <div class="min-w-0">
                <h4 class="text-sm font-semibold leading-snug text-slate-900 dark:text-white">
                  {c.title}
                </h4>
                <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{c.issuer}</p>
              </div>
            </div>

            {c.credentialUrl && (
              <div class="mt-3 flex justify-end border-t border-slate-100 pt-2.5 dark:border-slate-800">
                <a
                  href={c.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
                >
                  <span>View Certificate</span>
                  <Icon name="lucide:external-link" class="h-3 w-3" aria-hidden="true" />
                </a>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</Section>
