---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';

interface Props {
  paragraphs: string[];
  competencies: string[];
  aboutPhoto: ImageMetadata;
}

const { paragraphs, competencies, aboutPhoto } = Astro.props;
---

<Section
  id="about"
  eyebrow="Profile"
  title="About Me"
  subtitle="Bridging data engineering, internal audit surveillance, and production software delivery."
  altBg
>
  <div class="grid items-start gap-10 md:grid-cols-12">
    <div class="md:col-span-5 lg:col-span-4">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-xs dark:border-slate-800 dark:bg-slate-900">
        <Image
          src={aboutPhoto}
          alt="Nurcahya Priantoro at IPB University"
          widths={[360, 720]}
          sizes="(max-width: 768px) 100vw, 360px"
          class="aspect-4/5 w-full object-cover object-top"
        />
      </div>
    </div>

    <div class="space-y-6 md:col-span-7 lg:col-span-8">
      <div class="space-y-4 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <div class="pt-2">
        <h3 class="mb-3 text-xs font-semibold tracking-wider text-slate-500 uppercase dark:text-slate-400">
          Core Competencies
        </h3>
        <div class="flex flex-wrap gap-2">
          {competencies.map((item) => (
            <Badge variant="brand">{item}</Badge>
          ))}
        </div>
      </div>
    </div>
  </div>
</Section>
