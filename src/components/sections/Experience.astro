---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import Badge from '@/components/ui/Badge.astro';
import LogoMark from '@/components/ui/LogoMark.astro';
import Carousel from '@/components/ui/Carousel.astro';
import { formatDateRange } from '@/lib/format-date';

interface Props {
  items: CollectionEntry<'experience'>[];
}

const { items } = Astro.props;
const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
const professional = sorted.filter((i) => i.data.category === 'professional');
const programs = sorted.filter((i) => i.data.category === 'program');
---

<Section
  id="experience"
  eyebrow="Career & Training"
  title="Experience"
  subtitle="Enterprise data engineering, internal audit surveillance, blockchain governance, and intensive engineering programs."
>
  <div class="space-y-14">
    <div>
      <h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
        <Icon
          name="lucide:briefcase"
          class="h-5 w-5 text-blue-600 dark:text-blue-400"
          aria-hidden="true"
        />
        <span>Professional Experience</span>
      </h3>

      <div class="relative space-y-8 border-l-2 border-slate-200 pl-6 sm:pl-8 dark:border-slate-800">
        {professional.map((entry) => {
          const d = entry.data;
          const isCurrent = d.end === 'present';
          return (
            <article class="relative rounded-2xl border border-slate-200/90 bg-white p-6 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
              <span
                class:list={[
                  'absolute top-8 -left-[33px] h-3.5 w-3.5 rounded-full border-2 border-white sm:-left-[41px] dark:border-slate-950',
                  isCurrent ? 'bg-emerald-500' : 'bg-blue-600',
                ]}
                aria-hidden="true"
              />

              <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
                <div class="flex items-start gap-4">
                  <LogoMark src={d.logo} alt={`${d.company} logo`} size="md" />
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h4 class="text-lg font-bold text-slate-900 dark:text-white">{d.role}</h4>
                      <Badge variant={isCurrent ? 'success' : 'brand'}>
                        {isCurrent ? 'Active' : d.type}
                      </Badge>
                    </div>
                    <p class="mt-0.5 text-sm font-semibold text-blue-600 dark:text-blue-400">
                      {d.company}
                    </p>
                    {d.department && (
                      <p class="text-xs font-medium text-slate-500 dark:text-slate-400">
                        {d.department}
                      </p>
                    )}
                  </div>
                </div>

                <div class="shrink-0 text-xs text-slate-500 sm:text-right dark:text-slate-400">
                  <p class="font-semibold text-slate-700 dark:text-slate-200">
                    {formatDateRange(d.start, d.end)}
                  </p>
                  <p class="mt-0.5">
                    {d.location}
                    {d.workMode ? ` · ${d.workMode}` : ''}
                  </p>
                </div>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {d.summary}
              </p>

              {d.metrics.length > 0 && (
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  {d.metrics.map((m) => (
                    <div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-2.5 dark:border-slate-800 dark:bg-slate-950/60">
                      <p class="text-lg font-extrabold text-blue-600 dark:text-blue-400">
                        {m.value}
                      </p>
                      <p class="text-xs text-slate-600 dark:text-slate-400">{m.label}</p>
                    </div>
                  ))}
                </div>
              )}

              <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-300">
                {d.highlights.map((h) => (
                  <li class="flex items-start gap-2.5">
                    <Icon
                      name="lucide:check"
                      class="mt-1 h-4 w-4 shrink-0 text-blue-600 dark:text-blue-400"
                      aria-hidden="true"
                    />
                    <span>
                      {h.title && (
                        <strong class="font-semibold text-slate-800 dark:text-slate-100">
                          {h.title}:{' '}
                        </strong>
                      )}
                      {h.text}
                    </span>
                  </li>
                ))}
              </ul>

              {d.gallery.length > 0 && (
                <div class="mt-5">
                  <Carousel
                    id={`exp-gallery-${entry.id}`}
                    label={`${d.company} gallery`}
                    slides={d.gallery.map((g) => ({
                      type: g.type,
                      src: g.src,
                      videoSrc: g.videoSrc,
                      poster: g.poster,
                      alt: g.caption,
                    }))}
                  />
                </div>
              )}

              <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
                <div class="flex flex-wrap gap-1.5">
                  {d.tech.map((t) => (
                    <Badge variant="default">{t}</Badge>
                  ))}
                </div>

                {d.links.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {d.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
                      >
                        <span>{l.label}</span>
                        <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <div>
      <h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
        <Icon
          name="lucide:sparkles"
          class="h-5 w-5 text-blue-600 dark:text-blue-400"
          aria-hidden="true"
        />
        <span>Engineering Academies &amp; Cohorts</span>
      </h3>

      <div class="grid gap-5 md:grid-cols-3">
        {programs.map((entry) => {
          const d = entry.data;
          return (
            <article class="flex flex-col rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs dark:border-slate-800 dark:bg-slate-900">
              <div class="flex items-start gap-3">
                <LogoMark src={d.logo} alt={`${d.company} logo`} size="sm" />
                <div class="min-w-0">
                  <p class="text-xs font-medium text-blue-600 dark:text-blue-400">
                    {formatDateRange(d.start, d.end)}
                  </p>
                  <h4 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
                    {d.role}
                  </h4>
                  <p class="text-xs font-medium text-slate-500 dark:text-slate-400">{d.company}</p>
                </div>
              </div>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                {d.summary}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {d.tech.slice(0, 4).map((t) => (
                  <Badge variant="default">{t}</Badge>
                ))}
              </div>

              {d.links.length > 0 && (
                <div class="mt-4 border-t border-slate-100 pt-3 dark:border-slate-800">
                  {d.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:underline dark:text-blue-400"
                    >
                      <span>{l.label}</span>
                      <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
                    </a>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </div>
</Section>
