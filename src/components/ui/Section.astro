---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  altBg?: boolean;
}

const { id, eyebrow, title, subtitle, altBg = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    'scroll-mt-20 py-16 md:py-24',
    altBg
      ? 'bg-white dark:bg-slate-900/50 border-y border-slate-200/70 dark:border-slate-800/70'
      : '',
  ]}
>
  <div class="mx-auto max-w-6xl px-5 sm:px-6 lg:px-8">
    <header class="mb-10 max-w-2xl md:mb-12">
      {eyebrow && (
        <p class="mb-2 text-xs font-semibold tracking-widest text-blue-600 uppercase dark:text-blue-400">
          {eyebrow}
        </p>
      )}
      <h2
        id={headingId}
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white"
      >
        {title}
      </h2>
      {subtitle && (
        <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">{subtitle}</p>
      )}
    </header>
    <slot />
  </div>
</section>
