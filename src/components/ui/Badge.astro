---
interface Props {
  variant?: 'default' | 'brand' | 'success' | 'neutral';
  class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;

const variants = {
  default:
    'bg-slate-100 text-slate-700 ring-1 ring-slate-200/80 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700/80',
  brand:
    'bg-blue-50 text-blue-700 ring-1 ring-blue-200/80 dark:bg-blue-950/60 dark:text-blue-300 dark:ring-blue-800/60',
  success:
    'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200/80 dark:bg-emerald-950/60 dark:text-emerald-300 dark:ring-emerald-800/60',
  neutral:
    'bg-white text-slate-700 ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:ring-slate-700',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium',
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
